# Copy this file to `.env.local` and fill in your key.
#   cp .env.local.example .env.local
#
# Get a key at https://aistudio.google.com/apikey  (Google AI Studio).
# This is read ONLY on the server (in app/api/* routes) and is never sent to the browser.
GEMINI_API_KEY=...

# Optional: override the Gemini model used for photo analysis + advice.
# Defaults to gemini-flash-latest (always the current Flash model) if unset.
# Pin a specific version if you prefer, e.g.:
# GEMINI_MODEL=gemini-3.5-flash

# Optional: Postgres connection string (Neon). When set, your food log is stored
# in the database so it syncs across devices and survives browser data clearing.
# When unset, the app falls back to browser localStorage — no database needed.
# On Vercel this is injected automatically by the Neon integration.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Invite code. Required to CREATE an account (share it only with people you
# want using the app). Without a database it also acts as the legacy shared
# password on the AI routes. Leave unset to allow open sign-up.
# APP_PASSWORD=choose-a-memorable-passphrase

# --- Sign in with Google (Auth.js) ---
# Only needed when a DATABASE_URL is set, i.e. when running with real accounts.
# AUTH_SECRET: generate with `openssl rand -base64 32`
# AUTH_GOOGLE_*: Google Cloud > Google Auth Platform > Clients > Web application.
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google
# AUTH_SECRET=...
# AUTH_GOOGLE_ID=....apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=GOCSPX-...

# Optional: per-user daily caps on AI calls (defaults 40 / 20).
# DAILY_ANALYZE_LIMIT=40
# DAILY_ADVICE_LIMIT=20
