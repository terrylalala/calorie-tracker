# Copy this file to `.env.local` and fill in your key.
#   cp .env.local.example .env.local
#
# Get a key at https://console.anthropic.com/  → API Keys.
# This is read ONLY on the server (in app/api/* routes) and is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for photo analysis + advice.
# Defaults to claude-opus-4-8 if unset.
# CLAUDE_MODEL=claude-opus-4-8
