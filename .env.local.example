# Copy this file to `.env.local` and fill in your key.
#   cp .env.local.example .env.local
#
# Get a key at https://aistudio.google.com/apikey  (Google AI Studio).
# This is read ONLY on the server (in app/api/* routes) and is never sent to the browser.
GEMINI_API_KEY=...

# Optional: override the Gemini model used for photo analysis + advice.
# Defaults to gemini-flash-latest (always the current Flash model) if unset.
# Pin a specific version if you prefer, e.g.:
# GEMINI_MODEL=gemini-3.5-flash

# Optional: protect the AI endpoints when deploying publicly.
# If set, callers must supply this same value (entered once in the app's Goals tab).
# This stops strangers from using your deployed URL to spend your Gemini quota.
# Leave unset for local use — no password required.
# APP_PASSWORD=choose-a-strong-passphrase
